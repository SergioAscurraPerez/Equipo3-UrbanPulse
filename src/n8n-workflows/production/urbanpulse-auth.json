      "name": "Crear operador (manual)"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "campo-username",
              "name": "username",
              "type": "string",
              "value": "cambiar_usuario"
            },
            {
              "id": "campo-password",
              "name": "password",
              "type": "string",
              "value": "cambiar_password_antes_de_ejecutar"
            },
            {
              "id": "campo-role",
              "name": "role",
              "type": "string",
              "value": "operador"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [224, 400],
      "id": "c4a2b001-1a2b-4c3d-9e4f-000000000009",
      "name": "Datos del operador"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst datos = $input.item.json;\nconst salt = crypto.randomBytes(16).toString('hex');\nconst hash = crypto.scryptSync(datos.password, salt, 64).toString('hex');\n\nreturn [{\n  json: {\n    username: datos.username,\n    password_hash: hash,\n    password_salt: salt,\n    role: datos.role || 'operador'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [448, 400],
      "id": "c4a2b001-1a2b-4c3d-9e4f-000000000010",
      "name": "Hashear password"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO usuarios (username, password_hash, password_salt, role)\nVALUES ($1, $2, $3, $4)\nON CONFLICT (username) DO NOTHING\nRETURNING id, username, role, created_at;",
        "options": {
          "queryReplacement": "={{ [$json.username, $json.password_hash, $json.password_salt, $json.role] }}"
        }
      },
