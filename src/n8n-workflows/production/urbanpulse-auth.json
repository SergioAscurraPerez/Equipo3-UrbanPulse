    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const filas = $input.all();\nconst body = $('Webhook Registro').first().json.body || {};\nconst email = (body.email || '').trim().toLowerCase();\nconst password = body.password || '';\n\n// Con alwaysOutputData, si el email está libre llega un item vacío en vez de 0 items\nconst yaExiste = filas.some((f) => f.json && f.json.id);\nconst formatoValido = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email);\n\nlet error = null;\nif (!formatoValido) {\n  error = 'Ingresa un correo electrónico válido.';\n} else if (password.length < 8) {\n  error = 'La contraseña debe tener al menos 8 caracteres.';\n} else if (yaExiste) {\n  error = 'Ya existe una cuenta con ese correo.';\n}\n\nreturn [{ json: { valido: error === null, error, email, password } }];"
