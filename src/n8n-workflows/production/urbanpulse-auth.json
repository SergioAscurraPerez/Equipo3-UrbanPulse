    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, username, password_hash, password_salt, role\nFROM usuarios\nWHERE username = $1;",
        "options": {
          "queryReplacement": "={{ [$json.body.username || ''] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [224, 0],
      "id": "c4a2b001-1a2b-4c3d-9e4f-000000000002",
      "alwaysOutputData": true,
      "name": "Buscar usuario",
      "credentials": {
        "postgres": {
          "id": "Il4alMQXMjgKNxRO",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nconst filas = $input.all();\nconst body = $('Webhook Login').first().json.body || {};\nconst password = body.password || '';\n\n// Con alwaysOutputData, si no hay coincidencia llega un item vacío en vez de 0 items\nconst usuario = filas.length > 0 ? filas[0].json : null;\nif (!usuario || !usuario.password_hash) {\n  return [{ json: { match: false, id: null, username: body.username || null, role: null } }];\n}\n\nconst hashCalculado = crypto.scryptSync(password, usuario.password_salt, 64);\nconst hashAlmacenado = Buffer.from(usuario.password_hash, 'hex');\n\nlet match = false;\nif (hashCalculado.length === hashAlmacenado.length) {\n  match = crypto.timingSafeEqual(hashCalculado, hashAlmacenado);\n}\n\nreturn [{ json: { match, id: usuario.id, username: usuario.username, role: usuario.role } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [448, 0],
      "id": "c4a2b001-1a2b-4c3d-9e4f-000000000003",
      "name": "Verificar credenciales"
    },
