        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0],
      "id": "c4a2b001-1a2b-4c3d-9e4f-000000000001",
      "name": "Webhook Login",
      "webhookId": "c4a2b001-1a2b-4c3d-9e4f-100000000001"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, username, password_hash, password_salt, role\nFROM usuarios\nWHERE username = $1;",
        "options": {
          "queryReplacement": "={{ [$json.body.username || ''] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [224, 0],
      "id": "c4a2b001-1a2b-4c3d-9e4f-000000000002",
      "name": "Buscar usuario",
      "credentials": {
        "postgres": {
          "id": "Il4alMQXMjgKNxRO",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nconst filas = $input.all();\nconst body = $('Webhook Login').item.json.body || {};\nconst password = body.password || '';\n\nif (filas.length === 0) {\n  return [{ json: { match: false, username: body.username || null, role: null } }];\n}\n\nconst usuario = filas[0].json;\nconst hashCalculado = crypto.scryptSync(password, usuario.password_salt, 64);\nconst hashAlmacenado = Buffer.from(usuario.password_hash, 'hex');\n\nlet match = false;\nif (hashCalculado.length === hashAlmacenado.length) {\n  match = crypto.timingSafeEqual(hashCalculado, hashAlmacenado);\n}\n\nreturn [{ json: { match, username: usuario.username, role: usuario.role } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [448, 0],
      "id": "c4a2b001-1a2b-4c3d-9e4f-000000000003",
      "name": "Verificar credenciales"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-match",
              "leftValue": "={{ $json.match }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [672, 0],
      "id": "c4a2b001-1a2b-4c3d-9e4f-000000000004",
      "name": "¿Credenciales válidas?"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst { username, role } = $('Verificar credenciales').item.json;\nconst secret = $env.N8N_AUTH_SECRET;\n\nconst now = Date.now();\nconst expiresAt = now + 1000 * 60 * 60 * 12; // 12 horas\n\nconst payload = { sub: username, role, iat: now, exp: expiresAt };\nconst payloadB64 = Buffer.from(JSON.stringify(payload)).toString('base64url');\nconst firma = crypto.createHmac('sha256', secret).update(payloadB64).digest('hex');\nconst token = payloadB64 + '.' + firma;\n\nreturn [{\n  json: {\n    success: true,\n    token,\n    username,\n    role,\n    expires_at: new Date(expiresAt).toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [896, -100],
      "id": "c4a2b001-1a2b-4c3d-9e4f-000000000005",
      "name": "Generar token"
    },
