        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [1120, -100],
      "id": "c4a2b001-1a2b-4c3d-9e4f-000000000006",
      "name": "Responder OK"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: false, error: 'Credenciales inválidas' } }}",
        "options": {
          "responseCode": 401
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [896, 100],
      "id": "c4a2b001-1a2b-4c3d-9e4f-000000000007",
      "name": "Responder 401"
    },
    {
      "parameters": {},
