    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const filas = $input.all();\nconst body = $('Webhook Registro').first().json.body || {};\nconst username = (body.username || '').trim();\nconst password = body.password || '';\n\n// Con alwaysOutputData, si el usuario está libre llega un item vacío en vez de 0 items\nconst yaExiste = filas.some((f) => f.json && f.json.id);\n\nlet error = null;\nif (username.length < 3) {\n  error = 'El usuario debe tener al menos 3 caracteres.';\n} else if (password.length < 8) {\n  error = 'La contraseña debe tener al menos 8 caracteres.';\n} else if (yaExiste) {\n  error = 'Ese usuario ya existe.';\n}\n\nreturn [{ json: { valido: error === null, error, username, password } }];"
      },
