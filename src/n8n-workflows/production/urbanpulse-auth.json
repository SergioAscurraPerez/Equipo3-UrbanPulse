        "jsCode": "const datos = $('Preparar token de reset').first().json;\n\n// Sin SMTP configurado no se puede enviar el correo, así que devolvemos el\n// enlace en la respuesta para poder continuar el flujo desde la interfaz.\nlet base = null;\ntry {\n  base = $env.URBANPULSE_FRONTEND_URL || null;\n} catch (e) {\n  base = null;\n}\nif (!base) {\n  base = 'https://equipo3-urban-pulse.vercel.app';\n}\n\nreturn [{\n  json: {\n    success: true,\n    email: datos.email,\n    reset_token: datos.reset_token,\n    reset_url: base + '/?reset_token=' + datos.reset_token,\n    expira: datos.reset_token_expira,\n    aviso: 'Sin SMTP configurado: el enlace se devuelve aquí en vez de enviarse por correo.'\n  }\n}];"
