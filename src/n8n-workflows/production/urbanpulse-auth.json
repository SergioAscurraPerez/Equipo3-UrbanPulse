      "name": "¿Credenciales válidas?"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst { id, email, username, role } = $('Verificar credenciales').first().json;\n\n// Lectura defensiva: si n8n bloquea el acceso a $env, antes reventaba el nodo\n// y el webhook respondía 200 con cuerpo vacío.\nlet secret = null;\ntry {\n  secret = $env.N8N_AUTH_SECRET || null;\n} catch (e) {\n  secret = null;\n}\n\nif (!secret) {\n  return [{ json: { success: false, error: 'El servidor no puede leer N8N_AUTH_SECRET. Verifica que exista en el contenedor de n8n y que N8N_BLOCK_ENV_ACCESS_IN_NODE sea false.' } }];\n}\n\nconst now = Date.now();\nconst expiresAt = now + 1000 * 60 * 60 * 12; // 12 horas\n\nconst payload = { sub: email, id, role, iat: now, exp: expiresAt };\nconst payloadB64 = Buffer.from(JSON.stringify(payload)).toString('base64url');\nconst firma = crypto.createHmac('sha256', secret).update(payloadB64).digest('hex');\nconst token = payloadB64 + '.' + firma;\n\nreturn [{\n  json: {\n    success: true,\n    token,\n    id,\n    email,\n    username,\n    role,\n    expires_at: new Date(expiresAt).toISOString()\n  }\n}];"
      },
