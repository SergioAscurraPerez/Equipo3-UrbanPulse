        "jsCode": "const crypto = require('crypto');\nconst filas = $input.all();\n\nconst usuario = filas.length > 0 && filas[0].json && filas[0].json.id ? filas[0].json : null;\nif (!usuario) {\n  return [{ json: { existe: false } }];\n}\n\nconst token = crypto.randomBytes(32).toString('hex');\nconst expira = new Date(Date.now() + 1000 * 60 * 60); // 1 hora\n\nreturn [{\n  json: {\n    existe: true,\n    id: usuario.id,\n    email: usuario.email,\n    reset_token: token,\n    reset_token_expira: expira.toISOString()\n  }\n}];"
