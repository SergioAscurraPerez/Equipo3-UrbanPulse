    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nconst filas = $input.all();\nconst body = $('Webhook Login').first().json.body || {};\nconst password = body.password || '';\n\n// Con alwaysOutputData, si no hay coincidencia llega un item vacío en vez de 0 items\nconst usuario = filas.length > 0 ? filas[0].json : null;\nif (!usuario || !usuario.password_hash) {\n  return [{ json: { match: false, id: null, email: body.email || null, username: null, role: null } }];\n}\n\nconst hashCalculado = crypto.scryptSync(password, usuario.password_salt, 64);\nconst hashAlmacenado = Buffer.from(usuario.password_hash, 'hex');\n\nlet match = false;\nif (hashCalculado.length === hashAlmacenado.length) {\n  match = crypto.timingSafeEqual(hashCalculado, hashAlmacenado);\n}\n\nreturn [{ json: { match, id: usuario.id, email: usuario.email, username: usuario.username, role: usuario.role } }];"
      },
