      "id": "3429dcaf-5b66-4c82-9eb2-c56919b0e60d",
      "name": "Recibir Evento"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const evento = $json;\nconst d = evento.datos || {};\n\nconst workflowName = d.workflow_nombre || 'Workflow desconocido';\nconst lastNode = d.nodo_fallido || 'Nodo desconocido';\nconst errorMessage = d.mensaje_error || 'Sin mensaje de error';\nconst fecha = evento.fecha || new Date().toISOString();\n\n// Base del n8n en Lightsail, usada solo para armar el link a la ejecucion.\n// Ajustar si la URL real de la instancia es otra.\nconst baseN8n = 'https://urbanpulse-n8n.xq33kajky1yy6.us-east-1.cs.amazonlightsail.com';\nlet executionUrl = '';\nif (d.workflow_id && d.ejecucion_id) {\n  executionUrl = `${baseN8n}/workflow/${d.workflow_id}/executions/${d.ejecucion_id}`;\n}\n\n// Prioridad: Alta para Central y auth; Media para el resto\nconst nombreNormalizado = workflowName.toLowerCase();\nconst prioridad = (nombreNormalizado.includes('central') || nombreNormalizado.includes('auth'))\n  ? '2'\n  : '3';\n\n// Slug del nombre del workflow para la etiqueta wf-<nombre>\nconst slug = workflowName\n  .toLowerCase()\n  .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n  .replace(/[^a-z0-9]+/g, '-')\n  .replace(/(^-|-$)/g, '');\n\nconst etiquetaWorkflow = `wf-${slug}`;\nconst resumen = `[n8n] ${workflowName} fallo en ${lastNode}`;\nconst descripcionTexto = `Workflow: ${workflowName}\\nNodo: ${lastNode}\\nError: ${errorMessage}\\nEjecucion: ${executionUrl || 'no disponible'}\\nFecha: ${fecha}\\nEvento: ${evento.id || ''}`;\n\nreturn {\n  json: {\n    workflowName,\n    lastNode,\n    errorMessage,\n    executionUrl,\n    fecha,\n    prioridad,\n    etiquetaWorkflow,\n    resumen,\n    descripcionTexto,\n    jql: `project = UPTI AND labels = \"${etiquetaWorkflow}\" AND created >= -15m ORDER BY created DESC`\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -784,
        -160
      ],
      "id": "47758aec-7aaa-42b3-9211-4b13af0a8b91",
