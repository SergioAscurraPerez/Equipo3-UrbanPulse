      ],
      "id": "c7a71a01-0001-4a01-9b01-000000000001",
      "name": "Webhook Guardar Turno",
      "webhookId": "c7a71a01-0001-4a01-9b01-100000000001"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Deja el turno al final del hilo que ya tenia la conversacion.\n-- La foto no se copia aqui: ya vive en conversaciones.imagen_base64 y meterla\n-- en cada mensaje haria crecer la fila sin necesidad. En el historial solo\n-- queda la marca de que ese mensaje traia una.\n-- La fila la crea el flujo del chat al primer mensaje; aqui solo se anade, y\n-- unicamente si la conversacion es de quien la manda.\nUPDATE conversaciones\nSET historial_mensajes = historial_mensajes || $3::jsonb,\n    updated_at = now()\nWHERE session_id = $1\n  AND (usuario_id IS NULL OR usuario_id = $2::uuid)\nRETURNING session_id, jsonb_array_length(historial_mensajes) AS mensajes_guardados;",
        "options": {
          "queryReplacement": "={{ [ $json.body.session_id || null, /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/.test($json.body.usuario_id || '') ? $json.body.usuario_id : null, JSON.stringify(Array.isArray($json.body.mensajes) ? $json.body.mensajes : []) ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        0
      ],
      "alwaysOutputData": true,
      "executeOnce": true,
      "id": "c7a71a01-0001-4a01-9b01-000000000002",
      "name": "Guardar turno",
      "credentials": {
        "postgres": {
          "id": "Il4alMQXMjgKNxRO",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "urbanpulse/chat-history",
        "responseMode": "lastNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        320
      ],
      "id": "c7a71a01-0001-4a01-9b01-000000000003",
      "name": "Webhook Leer Hilo",
      "webhookId": "c7a71a01-0001-4a01-9b01-100000000003"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Hilo guardado de una conversacion, solo para su dueno.\n-- imagen_base64 viaja aparte porque el historial guarda la marca del mensaje\n-- con foto, no la foto en si.\nSELECT session_id, estado, historial_mensajes, imagen_base64, updated_at\nFROM conversaciones\nWHERE session_id = $1\n  AND (usuario_id IS NULL OR usuario_id = $2::uuid);",
        "options": {
          "queryReplacement": "={{ [ $json.query.session_id || null, /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/.test($json.query.usuario_id || '') ? $json.query.usuario_id : null ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        320
      ],
      "alwaysOutputData": true,
      "executeOnce": true,
      "id": "c7a71a01-0001-4a01-9b01-000000000004",
      "name": "Hilo de la conversacion",
      "credentials": {
