{
  "name": "UrbanPulse - Historial del chat",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "urbanpulse/chat-history-append",
        "responseMode": "lastNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
