    {
      "name": "01 - Reporte valido con bache",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:5678/webhook/urbanpulse/report",
          "host": [
            "http://localhost:5678/webhook/urbanpulse/report"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{ \"description\": \"Hay un bache grande en la Av. Javier Prado que dificulta el paso de vehiculos\", \"latitude\": -12.0464, \"longitude\": -77.0428 }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200)); pm.test(\"Tiene incident_type\", () => pm.expect(pm.response.json().incident_type).to.exist);"
            ]
          }
        }
      ]
    },
