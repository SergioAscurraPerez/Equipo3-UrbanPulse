{
  "info": {
    "_postman_id": "42b62141-84a7-4a5d-8bdd-4a75b647c058",
    "name": "UrbanPulse - Regresion (Etapas 2-5)",
    "description": "Coleccion Newman generada a partir de 'postman/collections/UrbanPulse - Pruebas QA'. Sigue el orden documentado en Proceso_Pruebas_Regresion_UrbanPulse: Etapa 1 (infra) y Etapa 6 (UI/Playwright) se ejecutan fuera de Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Etapa 2 - Integracion aislada (Gemini / TomTom)",
      "item": [
        {
          "name": "08 - Integracion aislada Gemini",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent?key={{gemini_api_key}}",
              "protocol": "https",
              "host": ["generativelanguage", "googleapis", "com"],
              "path": ["v1beta", "models", "gemini-flash-latest:generateContent"],
              "query": [
                {
                  "key": "key",
                  "value": "{{gemini_api_key}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{ \"contents\": [{ \"parts\": [{ \"text\": \"Responde únicamente con la palabra OK si puedes leer este mensaje.\" }] }] }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Gemini devuelve una respuesta con texto\", () => {",
                  "  const json = pm.response.json();",
                  "  const text = json.candidates && json.candidates[0] && json.candidates[0].content.parts[0].text;",
                  "  pm.expect(text).to.exist;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "09 - Integracion TomTom",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://api.tomtom.com/traffic/services/4/flowSegmentData/absolute/10/json?point=-12.0464,-77.0428&key={{tomtom_api_key}}",
              "protocol": "https",
              "host": ["api", "tomtom", "com"],
              "path": ["traffic", "services", "4", "flowSegmentData", "absolute", "10", "json"],
              "query": [
                {
                  "key": "point",
                  "value": "-12.0464,-77.0428"
                },
                {
                  "key": "key",
                  "value": "{{tomtom_api_key}}"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TomTom responde con datos de trafico\", () => { const data = pm.response.json().flowSegmentData; pm.expect(data.currentSpeed).to.exist; pm.expect(data.freeFlowSpeed).to.exist; });"
                ]
              }
            }
          ]
        }
      ]
    },
