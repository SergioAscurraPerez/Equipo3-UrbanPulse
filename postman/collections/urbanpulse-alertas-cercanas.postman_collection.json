    {
      "name": "4. Distancia: 499 m si, 501 m no",
      "item": [
        {
          "name": "GET /alertas del ciudadano a 499 m -> 1 alerta",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const hasta = Date.now() + 3000;",
                  "while (Date.now() < hasta) { /* deja correr al suscriptor */ }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// El suscriptor corre despues de que el enrutador responde 202: se reintenta hasta 6 veces.",
                  "const clave = 'intentos_' + pm.info.requestId;",
                  "const intento = Number(pm.collectionVariables.get(clave) || 0);",
                  "if (pm.response.code === 200 && pm.response.json().length === 0 && intento < 6) {",
                  "  pm.collectionVariables.set(clave, intento + 1);",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "  return;",
                  "}",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const lista = pm.response.json();",
                  "pm.test('Tiene exactamente una alerta', () => pm.expect(lista).to.have.lengthOf(1));",
                  "const alerta = lista[0];",
                  "pm.test('La alerta trae el formato del contrato', () => {",
                  "  pm.expect(alerta).to.have.all.keys('id', 'reporte_id', 'tipo', 'severidad', 'distancia_m', 'lat', 'lng', 'creada_en');",
                  "  pm.expect(alerta.reporte_id).to.equal(pm.collectionVariables.get('reporte_id'));",
                  "  pm.expect(alerta.severidad).to.equal('alta');",
                  "});",
                  "pm.test('Distancia de 499 m (+-1 m por el redondeo)', () => pm.expect(alerta.distancia_m).to.be.within(498, 500));",
                  "pm.collectionVariables.set('alerta_id', alerta.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_cerca}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/webhook/urbanpulse/alertas",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "webhook",
                "urbanpulse",
                "alertas"
              ]
            },
            "description": "Dentro del radio de 500 m (ST_DWithin)."
          },
          "response": []
        },
